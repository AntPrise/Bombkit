{
  "name": "bombkit-script-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Game of Bombs script library and Electron workspace",
  "main": "desktop/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check app/app.js && node --check desktop/main.js && node --check desktop/preload.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.bombkit.workspace",
    "productName": "BombKit",
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
